# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/dealership?schema=public"

# Session signing secret – generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me"

# Public site URL (used for canonical URLs, sitemap, WhatsApp links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial Super Admin created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeThisPassword!123"

# Cloudinary (optional). If unset, uploads are stored on local disk in /uploads
# (fine for a VPS with persistent disk; NOT for serverless hosts like Vercel).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""


# Email notifications for new leads (optional). Leave blank to disable.
# Gmail example: smtp.gmail.com / 587 / your address / an App Password
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Where alerts go; defaults to the email set in Admin > Settings
NOTIFY_EMAIL=""
